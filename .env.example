# AI Beauty — environment configuration
#
# The mobile app NEVER talks to AI/auth vendors directly with a secret key.
# It calls YOUR backend (see /backend) which holds the real keys.
# These are the only values the client needs.

# ---------------------------------------------------------------------------
# Backend (AI generation, Fit Check analysis, email/password auth)
# ---------------------------------------------------------------------------
# Base URL of your deployed /backend service (see backend/README.md).
# In development, an unset backend can use the local DemoAIProvider for UI
# testing. Production is fail-closed: a real HTTPS backend URL is required.
EXPO_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Weather
# ---------------------------------------------------------------------------
# Live weather uses Open-Meteo (open-meteo.com), a free public API that
# requires NO key, called directly from the client. No configuration needed.
# Automatic weather never fabricates a current reading: if location/network
# is unavailable, Today's Look continues without a weather claim. When the user
# explicitly turns automatic weather OFF, a seasonal estimate may be used.

# ---------------------------------------------------------------------------
# Sign in with Google
# ---------------------------------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Android + iOS + Web "Expo proxy" client as needed for Expo Go testing).
# Until this is set, the Google button is replaced with an honest
# "not configured" notice — never a dead button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------------------------------------------------------------------------
# Sign in with Apple (iOS only)
# ---------------------------------------------------------------------------
# Requires an Apple Developer account with "Sign In with Apple" capability
# enabled on your App ID, and building with EAS/Xcode (not Expo Go).
# No client-side key needed beyond enabling the capability + the
# expo-apple-authentication plugin in app.json (already added).

# ---------------------------------------------------------------------------
# Subscriptions (RevenueCat)
# ---------------------------------------------------------------------------
# Create a project at https://app.revenuecat.com, connect App Store Connect /
# Google Play Console products, and paste the public SDK keys below.
# In development only, missing keys use DemoSubscriptionProvider so the UI
# can be tested without real charges. Production builds fail closed when the
# platform-specific RevenueCat key is missing and never grant sandbox Plus.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_ENABLE_SHOW_IT_ON_ME is reserved for when a real image-generation
# try-on provider is implemented behind AIProvider. Until then, Fit Check
# always shows an honest "not configured" notice for this feature regardless
# of this flag's value — there is no working try-on implementation to gate.
EXPO_PUBLIC_ENABLE_SHOW_IT_ON_ME=false
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=false

# Optional direct verified weekly fashion/beauty trend JSON feed.
# Recommended production setup: leave this empty so the app uses
# EXPO_PUBLIC_API_BASE_URL/v1/trends/weekly and the backend owns the real source.
EXPO_PUBLIC_TREND_FEED_URL=

# ---------------------------------------------------------------------------
# Expo Application Services (cloud builds / submissions)
# ---------------------------------------------------------------------------
# Real UUID created when the project is linked to the owner's Expo/EAS account.
# Do not invent this value. Local/native source checks do not require it.
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Pre-release verification
# ---------------------------------------------------------------------------
# Run `npm run release:source-check` for static source/config blockers.
# Run `npm run release:env-check` in the production build environment. It
# intentionally fails if required owner-supplied values are missing/invalid.
# For a platform-specific signed-build check, set BUILD_PLATFORM=android or ios
# before `npm run release:signed-build-check`. Use BUILD_PLATFORM=all for both stores.
