# AI Beauty backend — server-side secrets only. Never ship this file, never
# put these values in the mobile app's .env.

# Required for /v1/looks/generate, /v1/looks/regenerate, /v1/fit-check/analyze
ANTHROPIC_API_KEY=

# Required for email/password auth (any long random string)
JWT_SECRET=

# Database. SQLite is development-only. Production startup fails closed unless
# DB_DRIVER=postgres and DATABASE_URL points to a persistent managed PostgreSQL DB.
DB_DRIVER=sqlite
DATABASE_FILE=./data.sqlite
DATABASE_URL=
DB_POOL_MAX=10
# Production defaults to no schema mutation during API startup. Run migrate:prod as a deployment step.
DB_AUTO_MIGRATE=false
DATABASE_SSL=require
DATABASE_SSL_REJECT_UNAUTHORIZED=false

PORT=8787

# Social token verification (server-side)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
APPLE_CLIENT_ID=

# Comma-separated web origins allowed to call this API in production.
# Native mobile requests normally have no Origin header.
CORS_ALLOWED_ORIGINS=
NODE_ENV=development

# RevenueCat webhook Authorization bearer value; use a long random secret.
# Webhook processing is idempotent by RevenueCat event.id and ignores older
# entitlement events that arrive after a newer event for the same user.
REVENUECAT_WEBHOOK_SECRET=

# Verified weekly fashion/beauty trend JSON source consumed only by the backend.
# Required in production. Expected JSON:
# { "source":"...", "sourceUrl":"https://...", "publishedAt":"ISO date",
#   "items":[{"category":"color|clothing|shoes|accessory|makeup|hair|seasonal","label":"...","notes":"..."}] }
TREND_SOURCE_URL=

# Before production deployment, set NODE_ENV=production and run:
#   npm run validate:production
# The validator checks required secrets/provider ids without printing values.

# Incident controls. Keep false during normal operation. These allow an operator
# to fail closed without shipping a new mobile binary.
MAINTENANCE_MODE=false
DISABLE_AI=false
DISABLE_TRENDS=false
# Optional deployment/version identifier exposed by health endpoints/logs.
RELEASE_ID=
